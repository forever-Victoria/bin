# ───────────── bin 网关配置 ─────────────
# 拷贝为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会提交。

# 服务端口：设备 WebSocket 与测试网页共用
PORT=8765

# 默认角色（见 roles.json）
DEFAULT_ROLE_ID=trash_can
ROLES_PATH=roles.json

# ── 豆包语音（火山引擎）通用凭证 ──
# 控制台：https://console.volcengine.com/speech/service/10028
VOLC_APPID=
VOLC_ACCESS_TOKEN=

# ASR（大模型流式语音识别 V3）
# Resource-Id：1.0 小时版 volc.bigasr.sauc.duration；2.0 用 volc.seedasr.sauc.duration
ASR_RESOURCE_ID=volc.bigasr.sauc.duration
ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
ASR_SAMPLE_RATE=16000

# TTS（语音合成 V1 ws_binary）
# cluster=volcano_tts（预置音色）；音色见 roles.json 的 voice 字段
TTS_CLUSTER=volcano_tts
TTS_WS_URL=wss://openspeech.bytedance.com/api/v1/tts/ws_binary
TTS_VOICE_TYPE=BV700_streaming
TTS_SAMPLE_RATE=24000
TTS_SPEED_RATIO=1.0
# 预留：升级 V3 双向流式时用 volc.service_type.10029（大模型）/ volc.megatts.default（复刻2.0）
TTS_RESOURCE_ID=volc.service_type.10029

# ── 豆包 LLM（火山方舟 Ark，OpenAI 兼容）──
# 控制台：https://console.volcengine.com/ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Model ID（如 doubao-seed-1-6-flash-250828）或自定义接入点 ep-xxx
ARK_MODEL=doubao-seed-1-6-flash-250828
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.8

# ── 行为 ──
BARGE_IN_ENABLED=false
MIN_TRANSCRIPT_CHARS=1
TRANSCRIPT_WAIT_SEC=12
TTS_CHUNK_MS=40
DEVICE_RAW_LOG=true
