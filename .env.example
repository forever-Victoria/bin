# ───────────── bin 网关配置 ─────────────
# 拷贝为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会提交。

# 服务端口：设备 WebSocket 与测试网页共用
PORT=8765

# 默认角色（见 roles.json）
DEFAULT_ROLE_ID=trash_can
ROLES_PATH=roles.json

# ── 豆包语音凭证 ──
# 新控制台「每个服务各有一对 APP ID + Access Token」，去对应服务行里复制。
# ASR（流式语音识别大模型 小时版）：
ASR_APPID=
ASR_ACCESS_TOKEN=
# TTS（语音合成）：
TTS_APPID=
TTS_ACCESS_TOKEN=
# 若 ASR 与 TTS 共用同一对凭证，上面四项留空，只填下面两项即可：
# VOLC_APPID=
# VOLC_ACCESS_TOKEN=

# ASR
# 你开通的是 1.0 → volc.bigasr.sauc.duration；2.0 → volc.seedasr.sauc.duration
ASR_RESOURCE_ID=volc.bigasr.sauc.duration
ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
ASR_SAMPLE_RATE=16000

# TTS
# cluster=volcano_tts（预置音色）；音色见 roles.json 的 speaker 字段
# 免授权可直接调用的预置音色：BV001_streaming(通用女声) / BV002_streaming(通用男声)
TTS_CLUSTER=volcano_tts
TTS_WS_URL=wss://openspeech.bytedance.com/api/v1/tts/ws_binary
TTS_VOICE_TYPE=BV001_streaming
TTS_SAMPLE_RATE=24000
TTS_SPEED_RATIO=1.0
# 预留：升级 V3 双向流式时用 volc.service_type.10029（大模型）/ volc.megatts.default（复刻2.0）
TTS_RESOURCE_ID=volc.service_type.10029

# ── 豆包 LLM（火山方舟 Ark，OpenAI 兼容）──
# 控制台：https://console.volcengine.com/ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Model ID（如 doubao-seed-1-6-flash-250828）或自定义接入点 ep-xxx；必须填你已开通的那个
ARK_MODEL=doubao-seed-1-6-flash-250828
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.8

# ── 行为 ──
BARGE_IN_ENABLED=false
# 全双工打断（需 ESP32 硬件 AEC 或浏览器 echoCancellation）
BARGE_IN_RMS_THRESHOLD=25
BARGE_IN_HOLD_MS=80
BARGE_IN_PRE_ROLL_MS=300
# 按设备实际播放进度计时；保护 AEC/VAD 起播收敛，不停止麦克风上传
BARGE_IN_STARTUP_GUARD_MS=600
# 保护窗结束后仍处于 AEC 收敛期，使用更严格门槛；之后恢复上面的常规参数
BARGE_IN_WARMUP_MS=2500
BARGE_IN_WARMUP_RMS_THRESHOLD=40
BARGE_IN_WARMUP_HOLD_MS=160
# 以下为回声残差保护的进阶调参，通常保持默认
BARGE_IN_ECHO_CORRELATION=0.62
BARGE_IN_ECHO_RESIDUAL_RMS=25
BARGE_IN_MIN_RESIDUAL_RATIO=0.25
BARGE_IN_REFERENCE_WINDOW_MS=1500
MIN_TRANSCRIPT_CHARS=1
TRANSCRIPT_WAIT_SEC=12
TTS_CHUNK_MS=40
TTS_STREAM_LEAD_MS=1000
DEVICE_RAW_LOG=true
