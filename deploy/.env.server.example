# bin gateway server environment template
# Copy to /root/bin-gateway/.env, fill credentials, then chmod 600.

PORT=8767
DEFAULT_ROLE_ID=trash_can
ROLES_PATH=roles.json

# Doubao ASR
ASR_APPID=
ASR_ACCESS_TOKEN=
ASR_RESOURCE_ID=volc.bigasr.sauc.duration
ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
ASR_SAMPLE_RATE=16000

# Doubao TTS
TTS_APPID=
TTS_ACCESS_TOKEN=
TTS_CLUSTER=volcano_tts
TTS_WS_URL=wss://openspeech.bytedance.com/api/v1/tts/ws_binary
TTS_VOICE_TYPE=BV001_streaming
TTS_SAMPLE_RATE=24000
TTS_SPEED_RATIO=1.0
TTS_RESOURCE_ID=volc.service_type.10029

# Doubao Ark LLM
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.8

# Full-duplex barge-in
BARGE_IN_ENABLED=true
BARGE_IN_RMS_THRESHOLD=40
BARGE_IN_HOLD_MS=80
BARGE_IN_PRE_ROLL_MS=300
BARGE_IN_STARTUP_GUARD_MS=600
BARGE_IN_WARMUP_MS=2500
BARGE_IN_WARMUP_RMS_THRESHOLD=60
BARGE_IN_WARMUP_HOLD_MS=160
BARGE_IN_ECHO_CORRELATION=0.62
BARGE_IN_ECHO_RESIDUAL_RMS=40
BARGE_IN_MIN_RESIDUAL_RATIO=0.45
BARGE_IN_REFERENCE_WINDOW_MS=1500

MIN_TRANSCRIPT_CHARS=1
TRANSCRIPT_WAIT_SEC=12
TTS_CHUNK_MS=40
TTS_START_BUFFER_MS=800
TTS_START_BUFFER_MAX_WAIT_MS=500
TTS_STREAM_LEAD_MS=1000
DEVICE_RAW_LOG=true
